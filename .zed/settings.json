{
  "languages": {
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "format_on_save": "on",
      "preferred_line_length": 80,
      "soft_wrap": "preferred_line_length"
    }
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "configuration": "pyproject.toml",
          "fixAll": true,
          "organizeImports": true
        }
      }
    }
  }
}
